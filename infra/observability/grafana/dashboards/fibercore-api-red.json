      "id": 2,
      "type": "stat",
      "title": "Alvo da API",
      "description": "1 = o Prometheus consegue ler /metrics (token certo).",
      "datasource": {
        "type": "prometheus",
        "uid": "fibercore-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "FORA"
                },
                "1": {
                  "text": "OK"
                }
              }
            }
          ],
          "noValue": "sem dado"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fibercore-prometheus"
          },
          "expr": "up{job=\"fibercore-api\"}",
          "instant": true
        }
      ]
    },
