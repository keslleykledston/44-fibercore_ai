# APENAS desenvolvimento. NÃO armazenar credenciais reais neste arquivo versionado.
# `make env-dev` gera .env.dev (ignorado pelo Git) com segredos aleatórios.
FIBERCORE_DB_PASSWORD=dev_only_change_this_password
FIBERCORE_APP_DB_PASSWORD=dev_only_app_role_password
FIBERCORE_WORKER_DB_PASSWORD=dev_only_worker_role_password
FIBERCORE_JWT_SECRET=dev_only_jwt_secret_change_me_0123456789
FIBERCORE_PII_HMAC_KEY=dev_only_pii_hmac_key_change_me_0123456789
# GenieACS existente deve ser acessado somente pelo Edge Connector em rede privada.
# Nunca colocar NBI_ACCESS_TOKEN real no git/CI/LLM.
# GENIEACS_NBI_URL=http://127.0.0.1:7557
# EDGE_LOCAL_ALLOWLIST=127.0.0.1:7557
# USP_CONTROLLER_MODE=disabled
# FIBERCORE_API_PORT=18420
FIBERCORE_JOB_SIGNING_KEY=  # base64 32-byte Ed25519 seed: `openssl rand -base64 32`; vazio = despacho de jobs desabilitado

# Plano de exposição do FRONTEND: DNS/TLS devem ser configurados no proxy real (ADR-0012).
# Este domínio NÃO deve ser tratado como ativo antes de aprovação do deploy.
FIBERCORE_PUBLIC_HOST=fibercore.devops.k3gsolutions.com.br
FIBERCORE_PUBLIC_URL=https://fibercore.devops.k3gsolutions.com.br
FIBERCORE_API_BASE_PATH=/api/v1
FIBERCORE_HELP_BASE_PATH=/ajuda
# ACME_EMAIL=configure_email_operacional_real
