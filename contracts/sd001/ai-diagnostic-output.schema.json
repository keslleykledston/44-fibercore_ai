{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fibercore.example/schema/sd001-ai-output.json",
  "title": "Structured AI diagnostic analysis (advisory only)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "summary_pt_br",
    "findings",
    "missing_data",
    "recommended_tests",
    "proposed_actions",
    "operator_message"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "enum": [
        "analysis_complete",
        "insufficient_evidence"
      ]
    },
    "summary_pt_br": {
      "type": "string",
      "maxLength": 1500,
      "pattern": "^(?!.*(([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}|([Ss]enha|[Pp]assword|[Pp]asswd|PSK|psk|[Pp]assphrase|[Ss]ecret|[Tt]oken|[Cc]have|[Pp]ppoe|[Uu]su[aá]rio|[Uu]ser(name)?)\\s*[:=]))[\\s\\S]*$"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "certainty",
          "severity",
          "evidence_ids",
          "explanation"
        ],
        "properties": {
          "category": {
            "enum": [
              "PON_OPTICAL",
              "PON_MASS_OUTAGE",
              "ONU_OFFLINE",
              "WAN_LINK",
              "WAN_AUTH",
              "WIFI_SIGNAL",
              "WIFI_INTERFERENCE",
              "LAN_PORT",
              "CPE_STALE_DATA",
              "ERP_STATUS",
              "INCONCLUSIVE"
            ]
          },
          "certainty": {
            "enum": [
              "confirmed",
              "likely",
              "possible",
              "insufficient_evidence"
            ]
          },
          "severity": {
            "enum": [
              "info",
              "low",
              "medium",
              "high"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?![0-9A-Fa-f]{2}([-:.]?[0-9A-Fa-f]{2}){5}$)[A-Za-z0-9_-]{1,64}$"
            },
            "uniqueItems": true
          },
          "explanation": {
            "type": "string",
            "maxLength": 1000,
            "pattern": "^(?!.*(([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}|([Ss]enha|[Pp]assword|[Pp]asswd|PSK|psk|[Pp]assphrase|[Ss]ecret|[Tt]oken|[Cc]have|[Pp]ppoe|[Uu]su[aá]rio|[Uu]ser(name)?)\\s*[:=]))[\\s\\S]*$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "certainty": {
                  "enum": [
                    "confirmed",
                    "likely",
                    "possible"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "evidence_ids": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "missing_data": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "enum": [
          "wan_speed_test_unsupported",
          "endpoint_test_missing",
          "cpe_offline",
          "cpe_data_stale",
          "olt_data_stale",
          "wifi_scan_missing",
          "bng_session_missing",
          "optical_rx_olt_missing"
        ]
      }
    },
    "recommended_tests": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "enum": [
          "customer_endpoint_speed_optional",
          "wifi_scan",
          "wan_reconnect_check",
          "optical_recheck",
          "near_router_test"
        ]
      }
    },
    "proposed_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_kind",
          "rationale",
          "evidence_ids"
        ],
        "properties": {
          "action_kind": {
            "enum": [
              "wifi_channel_change",
              "wifi_band_steering",
              "wan_reconnect",
              "cpe_reboot",
              "plan_profile_align"
            ]
          },
          "rationale": {
            "type": "string",
            "maxLength": 1000,
            "pattern": "^(?!.*(([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}|([Ss]enha|[Pp]assword|[Pp]asswd|PSK|psk|[Pp]assphrase|[Ss]ecret|[Tt]oken|[Cc]have|[Pp]ppoe|[Uu]su[aá]rio|[Uu]ser(name)?)\\s*[:=]))[\\s\\S]*$"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?![0-9A-Fa-f]{2}([-:.]?[0-9A-Fa-f]{2}){5}$)[A-Za-z0-9_-]{1,64}$"
            },
            "uniqueItems": true,
            "minItems": 1
          }
        }
      },
      "maxItems": 5
    },
    "operator_message": {
      "type": "string",
      "maxLength": 1000,
      "pattern": "^(?!.*(([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}|([Ss]enha|[Pp]assword|[Pp]asswd|PSK|psk|[Pp]assphrase|[Ss]ecret|[Tt]oken|[Cc]have|[Pp]ppoe|[Uu]su[aá]rio|[Uu]ser(name)?)\\s*[:=]))[\\s\\S]*$"
    }
  },
  "description": "Saída estruturada e SOMENTE consultiva do copiloto (SD-001; só após ADR-0015/ADR-SD-006). Nunca autoriza nem executa: proposed_actions são sugestões para o motor de política. Texto narrativo: o schema só rejeita padrões óbvios (MAC e chave=valor de credencial) e limita o tamanho; NÃO prova ausência de segredo. O controle real é de execução: o modelo só recebe evidência já redigida (ADR-SD-002/ADR-SD-006) e a saída passa por redator antes de persistir ou exibir (requisito do PR que habilitar o copiloto; a flag smart_diagnostics_copilot segue desligada). A interface mostra como texto puro, nunca HTML."
}
