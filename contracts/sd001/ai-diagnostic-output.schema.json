{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fibercore.example/schema/sd001-ai-output.json",
  "title": "Structured AI diagnostic analysis (advisory only)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "summary_pt_br",
    "findings",
    "missing_data",
    "recommended_tests",
    "proposed_actions",
    "operator_message"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "enum": [
        "analysis_complete",
        "insufficient_evidence"
      ]
    },
    "summary_pt_br": {
      "type": "string",
      "maxLength": 1500
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "certainty",
          "severity",
          "evidence_ids",
          "explanation"
        ],
        "properties": {
          "category": {
            "type": "string"
          },
          "certainty": {
            "enum": [
              "confirmed",
              "likely",
              "possible",
              "insufficient_evidence"
            ]
          },
          "severity": {
            "enum": [
              "info",
              "low",
              "medium",
              "high"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?![0-9A-Fa-f]{2}([-:.]?[0-9A-Fa-f]{2}){5}$)[A-Za-z0-9_-]{1,64}$"
            },
            "uniqueItems": true
          },
          "explanation": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "certainty": {
                  "enum": [
                    "confirmed",
                    "likely",
                    "possible"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "evidence_ids": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "missing_data": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 200
      }
    },
    "recommended_tests": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 100
      }
    },
    "proposed_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_kind",
          "rationale",
          "evidence_ids"
        ],
        "properties": {
          "action_kind": {
            "enum": [
              "wifi_channel_change",
              "wifi_band_steering",
              "wan_reconnect",
              "cpe_reboot",
              "plan_profile_align"
            ]
          },
          "rationale": {
            "type": "string",
            "maxLength": 1000
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?![0-9A-Fa-f]{2}([-:.]?[0-9A-Fa-f]{2}){5}$)[A-Za-z0-9_-]{1,64}$"
            },
            "uniqueItems": true,
            "minItems": 1
          }
        }
      },
      "maxItems": 5
    },
    "operator_message": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "description": "Saída estruturada e SOMENTE consultiva do copiloto (SD-001; só após ADR-0015/ADR-SD-006). Nunca autoriza nem executa: proposed_actions são sugestões para o motor de política."
}
