{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fibercore.local/job-envelope.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "tenant_id", "edge_id", "target_id", "operation", "idempotency_key", "issued_at", "expires_at", "nonce", "intent_sha256", "policy_version", "signature"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "job_id": {"type": "string", "format": "uuid"},
    "tenant_id": {"type": "string", "format": "uuid"},
    "edge_id": {"type": "string", "format": "uuid"},
    "target_id": {"type": "string", "format": "uuid"},
    "target_ref": {"type": "string", "pattern": "^[A-Za-z0-9._%-]{3,200}$", "description": "refresh on a CPE only: the ACS device id the Edge may read (ADR-SD-002 item 4); covered by the signature"},
    "authorization_id": {"type": "string", "format": "uuid", "description": "bench writes only (ADR-0030): the single-use prior authorization consumed by this job; covered by the signature"},
    "authorization_ends_at": {"type": "string", "format": "date-time", "description": "bench writes only: end of the authorization window; expires_at is never later"},
    "owner_epoch": {"type": "integer", "minimum": 1, "description": "bench writes and olt_query: generation of the target's ownership; the Edge rejects a lower one (ADR-0029/0030)"},
    "params": {"description": "bench writes (ADR-0030), speed tests (ADR-0038) or olt_query (ADR-0029) only: the catalog-validated parameters of the operation; covered by the signature",
      "oneOf": [
        {"type": "object", "additionalProperties": false, "properties": {"ssid": {"type": "string", "pattern": "^BANCADA-[A-Z0-9]{1,16}$"}}},
        {"type": "object", "additionalProperties": false, "required": ["query_id", "olt_ref", "catalog_version"], "properties": {
          "query_id": {"type": "string", "pattern": "^[a-z]+(\\.[a-z]+)+$"}, "olt_ref": {"type": "string", "format": "uuid"},
          "catalog_version": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "slot": {"type": "integer", "minimum": 0, "maximum": 17}, "port": {"type": "integer", "minimum": 0, "maximum": 15}, "ont": {"type": "integer", "minimum": 0, "maximum": 127}}},
        {"type": "object", "additionalProperties": false, "required": ["target", "profile"], "properties": {
          "target": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,30}$", "description": "speed tests only (ADR-0038): a LOGICAL endpoint id, never a URL or address; the Edge maps it to its own validated local destination"},
          "profile": {"type": "string", "enum": ["10mb", "50mb", "200mb"]}}}]},
    "operation": {"type": "string", "enum": ["collect", "refresh", "reboot_cpe", "set_wifi_ssid", "onu_reset", "onu_deactivate", "speed_test_download", "speed_test_upload", "provision_onu", "olt_query"]},
    "parameters_ref": {"type": "string", "description": "Encrypted, scoped payload reference; no plaintext secret in envelope"},
    "idempotency_key": {"type": "string", "minLength": 8},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "nonce": {"type": "string"},
    "intent_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "policy_version": {"type": "string"},
    "approval_ids": {"type": "array", "items": {"type": "string", "format": "uuid"}},
    "signature": {"type": "string", "description": "Detached signature encoded; precise algorithm/key distribution via ADR"}
  }
}
