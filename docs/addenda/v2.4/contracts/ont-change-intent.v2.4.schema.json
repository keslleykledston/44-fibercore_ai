{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fibercore.local/ont-change-intent.v2.4.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant_id",
    "ont_id",
    "snapshot_revision",
    "change_items"
  ],
  "properties": {
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "ont_id": {
      "type": "string",
      "format": "uuid"
    },
    "snapshot_revision": {
      "type": "string"
    },
    "change_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability",
          "instance_key"
        ],
        "properties": {
          "capability": {
            "type": "string"
          },
          "instance_key": {
            "type": "string"
          },
          "desired_value": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "secret_ref": {
            "type": "string"
          }
        }
      }
    },
    "reason": {
      "type": "string"
    },
    "recovery_plan_ref": {
      "type": "string"
    }
  }
}
