{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fibercore.local/contracts/event-v2.2.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "schema_version",
    "tenant_id",
    "subject_id",
    "type",
    "source",
    "occurred_at",
    "ingested_at",
    "quality"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "schema_version": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "subject_id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "ingested_at": {
      "type": "string",
      "format": "date-time"
    },
    "quality": {
      "enum": [
        "fresh",
        "stale",
        "unknown",
        "conflict"
      ]
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object"
    }
  }
}
