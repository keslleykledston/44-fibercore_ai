{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://fibercore.devops.k3gsolutions.com.br/contracts/onu-quick-inspector.schema.json",
  "title":"ONU Quick Inspector View Model (proposto, nao substitui contratos v2)",
  "type":"object",
  "additionalProperties":false,
  "required":["onu","pon","acs","optical","association","visual","authorization","capabilities"],
  "properties":{
    "onu":{"type":"object","additionalProperties":false,"required":["id","display_name"],"properties":{
      "id":{"type":"string","minLength":1},"display_name":{"type":"string"},"serial_masked":{"type":["string","null"]},"manufacturer":{"type":["string","null"]},"model":{"type":["string","null"]},"olt_name":{"type":["string","null"]},"pon_ref":{"type":["string","null"]},"onu_id":{"type":["string","null"]}
    }},
    "pon":{"$ref":"#/$defs/connectionState"},
    "acs":{"$ref":"#/$defs/managementState"},
    "optical":{"type":"object","additionalProperties":false,"required":["rx_dbm","severity","source","observed_at","collected_at","freshness"],"properties":{
      "rx_dbm":{"type":["number","null"]},
      "severity":{"enum":["normal","warning","critical","unknown"]},
      "source":{"enum":["olt","acs","usp","unknown"]},
      "observed_at":{"type":["string","null"],"format":"date-time"},
      "collected_at":{"type":["string","null"],"format":"date-time"},
      "freshness":{"$ref":"#/$defs/freshness"}
    }},
    "association":{"type":"object","additionalProperties":false,"required":["confidence","customer_display_name"],"properties":{
      "confidence":{"enum":["confirmed","medium","low","conflict","unassociated","unknown"]},
      "customer_display_name":{"type":["string","null"]},
      "contract_label":{"type":["string","null"]},
      "source":{"type":["string","null"]}
    }},
    "visual":{"type":"object","additionalProperties":false,"required":["type","template_id","leds_homologated"],"properties":{
      "type":{"enum":["generic","homologated"]},
      "template_id":{"type":["string","null"]},
      "leds_homologated":{"type":"boolean"}
    }},
    "authorization":{"type":"object","additionalProperties":false,"required":["can_view_customer","can_open_360","can_investigate"],"properties":{
      "can_view_customer":{"type":"boolean"},"can_open_360":{"type":"boolean"},"can_investigate":{"type":"boolean"}
    }},
    "capabilities":{"type":"object","additionalProperties":false,"required":["has_optical_rx","has_acs","has_investigation_flow"],"properties":{
      "has_optical_rx":{"type":"boolean"},"has_acs":{"type":"boolean"},"has_investigation_flow":{"type":"boolean"}
    }}
  },
  "$defs":{
    "freshness":{"enum":["fresh","stale","unavailable","unsupported","unknown"]},
    "connectionState":{"type":"object","additionalProperties":false,"required":["state","source","observed_at","collected_at","freshness"],"properties":{
      "state":{"enum":["online","offline","unknown"]},"source":{"enum":["olt","unknown"]},
      "observed_at":{"type":["string","null"],"format":"date-time"},"collected_at":{"type":["string","null"],"format":"date-time"},"freshness":{"$ref":"#/$defs/freshness"}
    }},
    "managementState":{"type":"object","additionalProperties":false,"required":["state","source","observed_at","collected_at","freshness"],"properties":{
      "state":{"enum":["connected","disconnected","unknown"]},"source":{"enum":["acs","usp","unknown"]},
      "observed_at":{"type":["string","null"],"format":"date-time"},"collected_at":{"type":["string","null"],"format":"date-time"},"freshness":{"$ref":"#/$defs/freshness"}
    }}
  }
}
